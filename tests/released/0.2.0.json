{
  "release": "0.2.0",
  "entry": {
    "version": 2,
    "minor_version": 1
  },
  "device": {
    "subentry_id": "released020heatpump",
    "title": "Heat pump",
    "data": {
      "manufacturer": "ACME",
      "model": "HP-1",
      "entities": [
        {
          "id": "status",
          "platform": "sensor",
          "name": "Status",
          "source_entity": "sensor.heatpump_status",
          "value_template": "{{ value.split(' - ')[-1] }}",
          "icon": "mdi:heat-pump",
          "copy_attributes": "selected",
          "attribute_names": [
            "error_code"
          ],
          "attribute_templates": {
            "next_code": "{{ attributes.error_code | int + 1 }}"
          }
        },
        {
          "id": "temperature",
          "platform": "sensor",
          "name": "Temperature",
          "source_entity": "sensor.heatpump_temperature",
          "unit_of_measurement": "\u00b0C",
          "device_class": "temperature",
          "state_class": "measurement"
        },
        {
          "id": "flow",
          "platform": "sensor",
          "name": "Flow",
          "source_entity": "climate.heatpump",
          "source_attribute": "flow_temperature"
        },
        {
          "id": "door",
          "platform": "binary_sensor",
          "name": "Door",
          "source_entity": "binary_sensor.heatpump_door"
        },
        {
          "id": "power",
          "platform": "switch",
          "name": "Power",
          "source_entity": "switch.heatpump_power",
          "action_on": [
            {
              "action": "test.on"
            }
          ],
          "action_off": [
            {
              "action": "test.off"
            }
          ]
        },
        {
          "id": "target",
          "platform": "number",
          "name": "Target",
          "source_entity": "sensor.heatpump_target",
          "min_value": 10,
          "max_value": 30,
          "step": 0.5,
          "unit_of_measurement": "\u00b0C",
          "action_set": [
            {
              "action": "test.set",
              "data": {
                "value": "{{ value }}"
              }
            }
          ]
        },
        {
          "id": "mode",
          "platform": "select",
          "name": "Mode",
          "source_entity": "sensor.heatpump_mode",
          "value_template": "{{ value.split(' - ', 1)[-1] }}",
          "options": [
            "In Betrieb",
            "Standby"
          ],
          "action_select": [
            {
              "action": "test.select",
              "data": {
                "code": "{{ {'In Betrieb': 18, 'Standby': 19}[option] }}"
              }
            }
          ]
        },
        {
          "id": "defrost",
          "platform": "button",
          "name": "Defrost",
          "action_press": [
            {
              "action": "test.defrost"
            }
          ]
        },
        {
          "id": "last_error",
          "platform": "sensor",
          "name": "Last error",
          "source_entity": "sensor.heatpump_error_time",
          "extra_sources": [
            "sensor.heatpump_error_code"
          ],
          "value_template": "{{ value }} - {{ sources['sensor.heatpump_error_code'].state.split(':', 1)[1] }}",
          "attribute_templates": {
            "code": "{{ sources['sensor.heatpump_error_code'].state.split(' - ')[0] | int }}"
          }
        },
        {
          "id": "window",
          "platform": "binary_sensor",
          "name": "Window",
          "source_entity": "binary_sensor.heatpump_window",
          "device_class": "window"
        }
      ]
    }
